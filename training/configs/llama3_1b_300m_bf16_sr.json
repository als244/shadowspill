{
  "run_dir": "training/runs/llama3_1b_300m_bf16_sr",
  "settings": [
    {
      "@call": "mlops.dispatch:set_deterministic_kernels",
      "enabled": true
    }
  ],
  "model": {
    "@call": "workloads.models.catalog:build_on_meta",
    "model": "llama3-numerical",
    "implementation": "mlops",
    "dtype": "bfloat16",
    "max_seq_len": 2048
  },
  "objective": "@workloads.recipes.text.objectives:next_token_prediction",
  "optimizer": "@mlops.optim:AdamW",
  "optimizer_args": {
    "betas": [
      0.9,
      0.95
    ],
    "weight_decay": 0.1,
    "parameter_rounding": "stochastic",
    "opt_state_rounding": "stochastic",
    "lr": 0.0003

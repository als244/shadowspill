  "data": {
    "@call": "workloads.recipes.text.data.packed:PackedTokens",
    "directory": "training/data/tokens/llama3"
  },
  "steps": 4578,
  "max_seq_len": 2048,
  "max_tokens_per_step": 65536,
  "max_tokens_per_microbatch": 8192,
  "seed": 0,
  "eval_every": 100,
  "eval_tokens": 81920,
  "checkpoint_every": 763,
  "wandb_project": "shadowspill-training",
  "schedules": {
    "optimizer_group.0.lr": {
      "@call": "shadowspill.training.schedules:WarmupCosine",
      "lr": 0.0003,
      "min_lr": 3e-05,
      "warmup_steps": 100,
      "total_steps": 4578
    }
  },
  "engine": "shadowspill",
  "execution_gib": 20,
  "spill_gib": 32,
  "initialize": {
    "@call": "workloads.recipes.text.initialization:from_catalog",
    "model": "llama3-numerical",
    "max_seq_len": 2048,
    "seed": 0
  }
}

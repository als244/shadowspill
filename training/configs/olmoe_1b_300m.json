{
  "run_dir": "training/runs/olmoe_1b_300m",
  "settings": [
    {
      "@call": "mlops.dispatch:set_deterministic_kernels",
      "enabled": true
    }
  ],
  "model": {
    "@call": "workloads.recipes.text.models:build_on_meta",
    "model": "@workloads.mlops:OLMoE",
    "dtype": "bfloat16",
    "config": {
      "@call": "workloads.recipes.text.models:config_preset",
      "preset": "@workloads.mlops:OLMoEConfig.numerical",
      "max_seq_len": 2048
    }
  },
  "objective": "@workloads.recipes.text.objectives:model_loss",
  "objective_args": {
    "aux_coef": 0.01
  },
  "optimizer": "@mlops.optim:AdamW",
  "optimizer_args": {
    "betas": [
      0.9,
      0.95
    ],
    "weight_decay": 0.1
  },
  "data": {
    "@call": "workloads.recipes.text.data:PackedTokens",
    "directory": "training/data/tokens/olmoe"
  },
  "steps": 4578,
  "max_seq_len": 2048,
  "max_tokens_per_step": 65536,
  "max_tokens_per_microbatch": 8192,
  "backend": {
    "@call": "shadowspill.training.backends:ShadowSpill",
    "execution_gib": 8,
    "spill_gib": 32,
    "artifact_store": "training/artifact_store"
  },
  "seed": 0,
  "eval_every": 100,
  "eval_batches": 10,
  "checkpoint_every": 763,
  "wandb_project": "shadowspill-training",
  "schedules": {
    "lr": {
      "@call": "shadowspill.training.schedules:WarmupCosine",
      "lr": 0.0003,
      "min_lr": 3e-05,
      "warmup_steps": 100,
      "total_steps": 4578
    }
  }
}

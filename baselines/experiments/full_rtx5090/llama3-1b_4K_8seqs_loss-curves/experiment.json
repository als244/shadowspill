{
  "schema_version": 1,
  "gpus": 1,
  "python": {
    "fsdp2": "baselines",
    "deepspeed": "baselines",
    "shadowspill": "shadowspill"
  },
  "case_timeout": 3600,
  "variables": {
    "models": "the directory holding the Hugging Face checkpoints, one directory per checkpoint",
    "corpora": "the directory holding the tokenized corpora prepare_corpus writes, one directory per tokenizer family"
  },
  "settings": {
    "model": "llama3-1b",
    "implementation": "mlops",
    "mode": "full",
    "checkpoint": "{models}/Llama-3.2-1B",
    "data": "{corpora}/llama3",
    "seed": 0,
    "sequence_length": 4096,
    "tokens_per_step": 32768,
    "tokens_per_microbatch": 4096,
    "model_dtype": "bfloat16",
    "master_dtype": "float32",
    "grad_dtype": "float32",
    "opt_state_dtype": "float32",
    "fuse_narrow_gradient_accumulation": false,
    "learning_rate": 1e-05,
    "weight_decay": 0.01,
    "warmup_steps": 1,
    "steps": 50,
    "cpu_threads": 8
  },
  "sweeps": [
    {
      "name": "shadowspill",
      "engine": "shadowspill",
      "config": "shadowspill.json"
    },
    {
      "name": "fsdp2",
      "engine": "fsdp2",
      "config": "fsdp2.json"
    },
    {
      "name": "deepspeed",
      "engine": "deepspeed",
      "config": "deepspeed.json"
    }
  ]
}

{
  "schema_version": 1,
  "gpus": 1,
  "python": {
    "fsdp2": "baselines",
    "deepspeed": "baselines",
    "shadowspill": "shadowspill"
  },
  "case_timeout": 3600,
  "summary_budgets_gib": [
    8,
    12,
    16,
    24,
    28,
    32
  ],
  "settings": {
    "model": "olmoe-7b-a1b",
    "implementation": "mlops",
    "mode": "full",
    "sequence_length": 16384,
    "tokens_per_step": 65536,
    "model_dtype": "bfloat16",
    "master_dtype": null,
    "grad_dtype": "bfloat16",
    "opt_state_dtype": "bfloat16",
    "warmup_steps": 1,
    "steps": 1,
    "cpu_threads": 8,
    "seed": 0
  },
  "sweeps": [
    {
      "name": "shadowspill",
      "engine": "shadowspill",
      "config": "shadowspill.json"
    },
    {
      "name": "deepspeed",
      "engine": "deepspeed",
      "config": "deepspeed.json"
    },
    {
      "name": "fsdp2",
      "engine": "fsdp2",
      "config": "fsdp2.json"
    }
  ]
}

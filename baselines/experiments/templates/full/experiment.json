{
  "schema_version": 1,
  "gpus": "@gpus",
  "python": {
    "fsdp2": "baselines",
    "deepspeed": "baselines",
    "shadowspill": "shadowspill"
  },
  "case_timeout": 3600,
  "summary_budgets_gib": "@summary_budgets",
  "variables": "@variables",
  "settings": {
    "model": "@model",
    "implementation": "@implementation",
    "mode": "full",
    "checkpoint": "@checkpoint",
    "data": "@corpus",
    "sequence_length": "@sequence_length",
    "tokens_per_step": "@tokens_per_step",
    "model_dtype": "bfloat16",
    "master_dtype": null,
    "grad_dtype": "bfloat16",
    "opt_state_dtype": "bfloat16",
    "warmup_steps": 1,
    "steps": 3,
    "cpu_threads": 8
  },
  "sweeps": [
    {
      "name": "shadowspill",
      "engine": "shadowspill",
      "config": "shadowspill.json"
    },
    {
      "name": "fsdp2",
      "engine": "fsdp2",
      "config": "fsdp2.json"
    },
    {
      "name": "deepspeed",
      "engine": "deepspeed",
      "config": "deepspeed.json"
    }
  ]
}

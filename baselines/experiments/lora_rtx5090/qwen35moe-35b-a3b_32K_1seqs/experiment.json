{
  "schema_version": 1,
  "gpus": 1,
  "python": {
    "fsdp2": "baselines",
    "deepspeed": "baselines",
    "shadowspill": "shadowspill"
  },
  "case_timeout": 3600,
  "summary_budgets_gib": [8, 12, 16, 24, 28, 32],
  "variables": {
    "models": "the directory holding the Hugging Face checkpoints, one directory per checkpoint",
    "corpora": "the directory holding the tokenized corpora prepare_corpus writes, one directory per tokenizer family"
  },
  "settings": {
    "model": "qwen35moe-35b-a3b",
    "implementation": "mlops",
    "mode": "lora",
    "lora": {
      "rank": 16,
      "alpha": 16.0
    },
    "checkpoint": "{models}/Qwen3.5-35B-A3B",
    "data": "{corpora}/qwen35",
    "seed": 0,
    "sequence_length": 32768,
    "tokens_per_step": 32768,
    "model_dtype": "bfloat16",
    "master_dtype": null,
    "grad_dtype": "bfloat16",
    "opt_state_dtype": "bfloat16",
    "warmup_steps": 1,
    "steps": 1,
    "cpu_threads": 8,
    "tokens_per_microbatch": 32768
  },
  "sweeps": [
    {
      "name": "shadowspill",
      "engine": "shadowspill",
      "config": "shadowspill.json"
    },
    {
      "name": "deepspeed",
      "engine": "deepspeed",
      "config": "deepspeed.json"
    },
    {
      "name": "fsdp2",
      "engine": "fsdp2",
      "config": "fsdp2.json"
    }
  ]
}

{
  "schema_version": 1,
  "gpus": 1,
  "python": {"fsdp2": "baselines", "deepspeed": "baselines", "shadowspill": "shadowspill"},
  "case_timeout": 3600,
  "settings": {
    "model": "qwen35-9b",
    "implementation": "mlops",
    "mode": "full",
    "sequence_length": 4096,
    "tokens_per_step": 65536,
    "model_dtype": "bfloat16",
    "master_dtype": null,
    "grad_dtype": "bfloat16",
    "opt_state_dtype": "bfloat16",
    "parameter_rounding": null,
    "opt_state_rounding": null,
    "fuse_narrow_gradient_accumulation": false,
    "warmup_steps": 3,
    "steps": 5,
    "cpu_threads": 8
  },
  "sweeps": [
    {"harness": "fsdp2", "config": "baselines/fsdp2/configs/rtx5090_full.json"},
    {"harness": "deepspeed", "config": "baselines/deepspeed/configs/rtx5090_full.json"},
    {"harness": "shadowspill", "config": "baselines/shadowspill/configs/rtx5090_full.json"}
  ]
}

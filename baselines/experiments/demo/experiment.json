{
  "schema_version": 1,
  "gpus": 1,
  "python": {"fsdp2": "baselines", "deepspeed": "baselines", "shadowspill": "shadowspill"},
  "case_timeout": 1800,
  "summary_budgets_gib": [4, 8, 16, 32],
  "settings": {
    "model": "llama3-1b",
    "implementation": "mlops",
    "mode": "full",
    "sequence_length": 1024,
    "tokens_per_step": 8192,
    "model_dtype": "bfloat16",
    "master_dtype": null,
    "grad_dtype": "bfloat16",
    "opt_state_dtype": "bfloat16",
    "warmup_steps": 1,
    "steps": 3,
    "cpu_threads": 8
  },
  "sweeps": [
    {"name": "shadowspill", "engine": "shadowspill", "config": "shadowspill.json"},
    {"name": "fsdp2", "engine": "fsdp2", "config": "fsdp2.json"},
    {"name": "deepspeed", "engine": "deepspeed", "config": "deepspeed.json"}
  ]
}

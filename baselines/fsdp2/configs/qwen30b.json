{
  "schema_version": 1,
  "defaults": {
    "sequence_length": 4096,
    "global_tokens": 2097152,
    "warmup_steps": 3,
    "steps": 5,
    "cpu_threads": 10,
    "gradient_sync": "per-microbatch",
    "forward_prefetch": 1,
    "backward_prefetch": "auto"
  },
  "grid": {
    "microbatch_tokens": [4096, 8192, 16384, 32768, 65536, 131072],
    "recompute": [0, 0.25, 0.5, 0.75, 1],
    "offload": ["none", "cpu"]
  }
}

    {"model": "llama3-tiny", "zero_stage": 3, "mode": "lora", "lora": {"rank": 4}, "recompute": 1},
    {"model": "llama3-tiny", "zero_stage": 2, "implementation": "pytorch", "recompute": 1},
    {"model": "llama3-tiny", "zero_stage": 3, "model_config": {"tied_embeddings": true}, "recompute": 1},
    {"model": "qwen35-tiny", "zero_stage": 2, "recompute": 1},
    {"model": "olmoe-tiny", "zero_stage": 3, "recompute": 1},
    {"model": "qwen3moe-tiny", "zero_stage": 2, "recompute": 1},
    {"model": "qwen35moe-tiny", "zero_stage": 3, "recompute": 0.5, "offload_optimizer": "cpu"}
  ]
}

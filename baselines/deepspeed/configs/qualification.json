{
  "schema_version": 1,
  "defaults": {
    "verify_reference": true,
    "sequence_length": 64,
    "tokens_per_step": 1024,
    "tokens_per_microbatch": 128,
    "warmup_steps": 1,
    "steps": 2,
    "cpu_threads": 2,
    "grad_dtype": "bfloat16"
  },
  "cases": [
    {"model": "llama3-tiny", "zero_stage": 1, "recompute": 0, "grad_dtype": "float32"},
    {"model": "llama3-tiny", "zero_stage": 2, "recompute": 1},
    {"model": "llama3-tiny", "zero_stage": 2, "recompute": 1, "activation_offload": "cpu"},
    {"model": "llama3-tiny", "zero_stage": 2, "recompute": 0.5, "offload_optimizer": "cpu"},
    {"model": "llama3-tiny", "zero_stage": 1, "recompute": 1},
    {"model": "llama3-tiny", "zero_stage": 3, "recompute": 1},
    {"model": "llama3-tiny", "zero_stage": 3, "recompute": 1, "offload_param": "cpu",
